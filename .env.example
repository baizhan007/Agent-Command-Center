# Comma-separated trusted parent folders. Project paths must be inside these roots.
ACC_ALLOWED_ROOTS=C:/Users/YOUR_USER/source/repos
ACC_DATA_DIR=C:/Users/YOUR_USER/AppData/Local/ACC
ACC_API_TOKEN=replace-with-a-long-random-local-token
ACC_MAX_PARALLEL=3
ACC_TASK_TIMEOUT_SECONDS=3600
ACC_DSH_EXECUTABLE=dsh
