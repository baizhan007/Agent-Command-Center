{
  "name": "agent-command-center-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first project and task control plane",
  "author": "ACC",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop:dev": "concurrently -k \"npm run dev\" \"wait-on tcp:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop:dist": "npm run build && electron-builder --win dir"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.49",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "wait-on": "^8.0.2"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.agentcommandcenter.desktop",
    "productName": "Agent Command Center",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop/backend/acc-api.exe",
        "to": "backend/acc-api.exe"
      }
    ],
    "win": {
      "target": [
        "zip"
      ],
      "artifactName": "ACC-Desktop-${version}.${ext}",
      "signAndEditExecutable": false
    }
  }
}
